linder;" vertex="1" parent="1"><mxGeometry x="925" y="5750" width="650" height="140" as="geometry" /></mxCell><mxCell id="A6" value="เว็บแอปแสดงใบเสร็จ&lt;br/&gt;และ QR ทางออก" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#E8F3FF;strokeColor=#25425C;strokeWidth=2;shape=document;" vertex="1" parent="1"><mxGeometry x="925" y="5960" width="650" height="130" as="geometry" /></mxCell><mxCell id="H4" value="IR4 + IR5 ก่อน Servo ทางออก&lt;br/&gt;ESP32-CAM ส่ง gate/event" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#FFF0E7;strokeColor=#25425C;strokeWidth=2;dashed=1;dashPattern=8 5;shape=parallelogram;" vertex="1" parent="1"><mxGeometry x="925" y="6160" width="650" height="130" as="geometry" /></mxCell><mxCell id="D9" value="payload มี IR4+IR5&lt;br/&gt;vehicle_detected=true?" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#FFFFFF;strokeColor=#25425C;strokeWidth=2;shape=rhombus;" vertex="1" parent="1"><mxGeometry x="925" y="6350" width="650" height="160" as="geometry" /></mxCell><mxCell id="A7" value="เปิดลิงก์ QR ทางออก&lt;br/&gt;GET /scan/{token}" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#E8F3FF;strokeColor=#25425C;strokeWidth=2;shape=parallelogram;" vertex="1" parent="1"><mxGeometry x="925" y="6580" width="650" height="130" as="geometry" /></mxCell><mxCell id="D10" value="Exit QR ใช้ได้ + paid&lt;br/&gt;คู่ IR และไม่มี override?" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#FFFFFF;strokeColor=#25425C;strokeWidth=2;shape=rhombus;" vertex="1" parent="1"><mxGeometry x="925" y="6770" width="650" height="160" as="geometry" /></mxCell><mxCell id="B8" value="Backend บันทึก open ทางออก&lt;br/&gt;MQTT parking/servo/command" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#FFFFFF;strokeColor=#25425C;strokeWidth=2;shape=rectangle;" vertex="