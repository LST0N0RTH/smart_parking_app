<mxfile host="app.diagrams.net" agent="Codex"><diagram id="continuous" name="Smart Parking Continuous System Flowchart"><mxGraphModel dx="2500" dy="8680" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2500" pageHeight="8680" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="background" value="" style="shape=rectangle;fillColor=#F5F7FB;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2500" height="8680" as="geometry" /></mxCell><mxCell id="heading" value="SYSTEM FLOWCHART · SMART PARKING" style="text;html=1;align=left;verticalAlign=middle;fontSize=43;fontColor=#112B44;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="31" width="2300" height="44" as="geometry" /></mxCell><mxCell id="subheading" value="เส้นทางหลักต่อเนื่องจากเริ่มระบบ → จอง → เข้า → ตรวจช่อง → ชำระ → ออก → จบรายการ" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#536B80;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="98" width="2300" height="44" as="geometry" /></mxCell><mxCell id="legend-symbols" value="สัญลักษณ์: วงรี เริ่ม/จบ · สี่เหลี่ยม กระบวนการ · ขนาน ข้อมูลเข้า/ออก · ข้าวหลามตัด ตัดสินใจ · ทรงกระบอก ฐานข้อมูล · เอกสาร QR/ผลลัพธ์ · วงกลม จุดเชื่อม" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#35516A;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="151" width="2300" height="44" as="geometry" /></mxCell><mxCell id="legend-evidence" value="เส้นประ = การทำงานจริงของ ESP32/LED/Servo ที่ยังไม่มีเฟิร์มแวร์ให้ยืนยัน · เส้นทึบ = พฤติกรรมที่อ่านได้จากโค้ด" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#35516A;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="183" width="2300" height="44" as="geometry" /></mxCell><mxCell id="foot-1" value="อุปกรณ์: ESP32-CAM ถอดกล้อง · IR1–IR6 · Servo ตัวเดียวทางเข้า/ออก · ESP32-WROOM · RGB LED ช่อง M/N/O · Webcam บริเวณช่องจอด" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#536B80;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="8405" width="2300" height="35" as="geometry" /></mxCell><mxCell id="foot-2" value="ตำแหน่งที่ผู้ใช้ระบุ: IR1/2 ตรงข้าม IR3 · IR3 ตรงข้าม IR4/5 · IR4/5 ตรงข้าม IR6 · IR6 ตรงข้าม IR1/2" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#536B80;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="8448" width="2300" height="35" as="geometry" /></mxCell><mxCell id="foot-3" value="paid คือสถานะที่ Backend บันทึก; ไม่พบการตรวจชำระจากธนาคารหรือ gateway · ไม่มีเฟิร์มแวร์ ESP32 หรือไฟล์ calibration/runtime ในชุดโค้ดที่ตรวจ" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#536B80;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="8491" width="2300" height="35" as="geometry" /></mxCell><mxCell id="foot-4" value="หลักฐานจากไฟล์และเลขบรรทัดอยู่ใน README.md · ไม่มีข้อมูลจำลองหรืออุปกรณ์สแกน QR ที่สมมติขึ้น" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#536B80;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="8534" width="2300" height="35" as="geometry" /></mxCell><mxCell id="START" value="เริ่ม: ระบบ Smart Parking" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#E8F3FF;strokeColor=#25425C;strokeWidth=2;shape=ellipse;" vertex="1" parent="1"><mxGeometry x="925" y="250" width="650" height="90" as="geometry" /></mxCell><mxCell id="A1" value="ผู้ใช้เข้าสู่ระบบ&lt;br/&gt;ขอสถานะช่อง M/N/O" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#E8F3FF;strokeColor=#25425C;strokeWidth=2;shape=parallelogram;" vertex="1" parent="1"><mxGeometry x="925" y="420" width="650" height="120" as="geometry" /></mxCell><mxCell id="B1" value="Backend ตรวจสิทธิ์&lt;br/&gt;ตอบ GET /slots" style="whiteSp